# Test Environment Configuration
# Copy this file to .env.test before running automated tests:
# cp .env.test.example .env.test

# Mandatory safety flag: tests will abort if not set to 1
ALLOW_TEST_DB_WRITE=1

# Node environment for testing
NODE_ENV=test

# Database URL for testing: MUST point to an isolated test database (local or Neon test branch)
# Allowed default hosts: localhost, 127.0.0.1, ::1
DATABASE_URL=postgresql://morphic:morphic@localhost:5432/morphic_test

# Comma-separated list of additional allowed database hostnames (e.g. for a dedicated Neon test branch)
# TEST_DB_HOST_ALLOWLIST=ep-test-branch-name.us-east-2.aws.neon.tech

# Redis connection (opsional untuk unit test lokal — jika kosong fallback ke in-memory)
# REDIS_URL=redis://localhost:6379

# Mock/Test Gateway & API Keys (non-sensitive placeholders for testing)
GATEWAY_IP_RPM=1000
WEBHOOK_IP_RPM=1000
PAYPAL_CLIENT_ID=test_client_id
PAYPAL_CLIENT_SECRET=test_client_secret
PAYPAL_WEBHOOK_ID=test_webhook_id
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_TEST_BYPASS=1
DUITKU_MERCHANT_CODE=D1234
DUITKU_API_KEY=test_duitku_key
DUITKU_ENV=sandbox
