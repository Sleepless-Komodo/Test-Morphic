# ── Core (Development) ──────────────────────────────────
NODE_ENV=development
NODE_OPTIONS=--dns-result-order=ipv4first

# ── Database / Redis ─────────────────────────────────────
# Neon development pooler DB or local postgresql://morphic:morphic@localhost:5432/morphic
DATABASE_URL=postgresql://neondb_owner:password@ep-dev-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# REDIS_URL=redis://localhost:6379  # Opsional di dev — rate limiter fallback ke memory

# ── Web (Localhost) ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8787

# ── Better Auth ──────────────────────────────────────────
BETTER_AUTH_SECRET=generate-random-32-chars-secret
BETTER_AUTH_URL=http://localhost:3000

# ── Google OAuth (Opsional di Dev) ───────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── API Gateway ──────────────────────────────────────────
API_PORT=8787
# AES-256-GCM key for provider credentials (32 bytes hex)
PROVIDER_ENC_KEY=
# Shared secret between web and api for internal calls
INTERNAL_API_SECRET=
HARD_RESERVE_CAP=16384
RESERVATION_TTL_MINUTES=10
UPSTREAM_TIMEOUT_MS=120000

# ── Provider API Keys ────────────────────────────────────
DAHL_API_KEY=

# ── Payments (Sandbox / Testing) ─────────────────────────
MOCK_PAYMENT_WEBHOOK_SECRET=mock-webhook-secret

# Duitku (Sandbox)
DUITKU_MERCHANT_CODE=DS35811
DUITKU_API_KEY=
DUITKU_ENV=sandbox

# PayPal (Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# ── Resend / Email ───────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Morphic <noreply@morphic-api.web.id>"

# ── reCAPTCHA ────────────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
