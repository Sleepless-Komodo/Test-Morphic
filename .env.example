# ── Core ──────────────────────────────────────────────
NODE_ENV=

# ── Database / Redis ─────────────────────────────────
DATABASE_URL=
REDIS_URL=

# ── Web ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_URL=
# Public gateway URL shown in dashboard/docs snippets (defaults to https://morphic-api.web.id)
NEXT_PUBLIC_GATEWAY_URL=

# ── Better Auth (wajib) ───────────────────────────────
# Generate secret acak 32+ karakter, contoh:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# ── Email (Resend) ────────────────────────────────────
# Wajib di production (OTP login, reset password). Kosong di dev → email dicetak ke console.
RESEND_API_KEY=
EMAIL_FROM="Morphic <noreply@morphic-api.web.id>"

# ── Google OAuth (opsional) ───────────────────────────
# 1. Buka https://console.cloud.google.com/apis/credentials
# 2. Buat "OAuth client ID" (Web application)
# 3. Authorized redirect URI:
#      http://localhost:3000/api/auth/callback/google
# Jika kosong, login Google akan menampilkan banner
# "Google OAuth belum dikonfigurasi" — gunakan login
# Email & Password sebagai gantinya.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── GitHub OAuth (opsional) ───────────────────────────
# 1. Buka https://github.com/settings/developers
# 2. Buat "OAuth App"
# 3. Authorization callback URL:
#      http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── API Gateway ───────────────────────────────────────
API_PORT=
# AES-256-GCM key for provider credentials (32 bytes hex)
PROVIDER_ENC_KEY=
# Shared secret between web and api for internal calls
INTERNAL_API_SECRET=
# Hard upper bound on output tokens used for credit reservation
HARD_RESERVE_CAP=
# Minutes before an unsettled reservation is auto-released
RESERVATION_TTL_MINUTES=

# ── Payments (mock for now) ───────────────────────────
MOCK_PAYMENT_WEBHOOK_SECRET=

# ── Google reCAPTCHA v2 (Proteksi Brute-force & Bot) ────
# 1. Buka https://www.google.com/recaptcha/admin/create
# 2. Pilih "reCAPTCHA v2" -> "I'm not a robot" Checkbox
# 3. Masukkan domain (contoh: localhost untuk dev)
# 4. Salin Site Key dan Secret Key ke bawah ini:
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
