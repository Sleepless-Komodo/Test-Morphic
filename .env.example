# ── Core ──────────────────────────────────────────────
NODE_ENV=

# ── Database / Redis ─────────────────────────────────
DATABASE_URL=
# Optional local PostgreSQL fallback (Termux 127.0.0.1:5432/morphic with sslmode=disable)
DATABASE_URL_FALLBACK=
# Keep false when web and API run on different hosts: failover state is per process, so only one of them would switch.
DB_FAILOVER_ENABLED=false
DB_SYNC_INTERVAL_MS=600000
# Salin pembayaran/redeem ke Postgres lokal segera setelah commit (false = hanya sync periodik)
DB_SYNC_ON_WRITE=true
DB_SYNC_ON_WRITE_DEBOUNCE_MS=1500
# Catch-up sync + self-check otomatis 3 detik setelah server start (false = matikan)
DB_SYNC_ON_BOOT=true
# true = the periodic sync also deletes local access rows (API keys, sessions, ...) removed on the primary.
# Run `pnpm db:sync-fallback --prune-deleted --dry-run` first.
DB_SYNC_PRUNE=false
# Audit reports for prune, sync-to-primary and deep parity (default ~/.morphic-audit)
# DB_AUDIT_DIR=
REDIS_URL=
# Local docker-compose only: password passed to Redis `--requirepass` and to the
# API via REDIS_URL. Production: use a strong secret, bind Redis to the private
# link only, and URL-encode special characters in REDIS_URL.
REDIS_PASSWORD=
# Multi-node background jobs (default true). Set false only for a single node.
JOB_LEASE_ENABLED=
# Multi-node safety: set true to refuse boot when REDIS_URL is unset.
REQUIRE_REDIS=

# ── Web ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_URL=
# Public gateway URL shown in dashboard/docs snippets (defaults to https://morphic-api.web.id)
NEXT_PUBLIC_GATEWAY_URL=

# ── Better Auth (wajib) ───────────────────────────────
# Generate secret acak 32+ karakter, contoh:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# ── Email (Resend) ────────────────────────────────────
# Wajib di production (OTP login, reset password). Kosong di dev → email dicetak ke console.
RESEND_API_KEY=
EMAIL_FROM="Morphic <noreply@morphic-api.web.id>"

# ── Google OAuth (opsional) ───────────────────────────
# 1. Buka https://console.cloud.google.com/apis/credentials
# 2. Buat "OAuth client ID" (Web application)
# 3. Authorized redirect URI:
#      http://localhost:3000/api/auth/callback/google
# Jika kosong, login Google akan menampilkan banner
# "Google OAuth belum dikonfigurasi" — gunakan login
# Email & Password sebagai gantinya.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── GitHub OAuth (opsional) ───────────────────────────
# 1. Buka https://github.com/settings/developers
# 2. Buat "OAuth App"
# 3. Authorization callback URL:
#      http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── API Gateway ───────────────────────────────────────
API_PORT=
# AES-256-GCM key for provider credentials (32 bytes hex)
PROVIDER_ENC_KEY=
# Shared secret between web and api for internal calls
INTERNAL_API_SECRET=
# Hard upper bound on output tokens used for credit reservation
HARD_RESERVE_CAP=
# Minutes before an unsettled reservation is auto-released
RESERVATION_TTL_MINUTES=

# ── Payments ──────────────────────────────────────────
MOCK_PAYMENT_WEBHOOK_SECRET=

# ── Duitku ────────────────────────────────────────────
# Merchant credentials must come from the Duitku merchant dashboard.
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_ENV=sandbox
# QRIS channel codes are merchant-configurable.
DUITKU_PRIMARY_PAYMENT_METHOD=SQ
DUITKU_BACKUP_PAYMENT_METHOD=SP

# ── Google reCAPTCHA v2 (Proteksi Brute-force & Bot) ────
# 1. Buka https://www.google.com/recaptcha/admin/create
# 2. Pilih "reCAPTCHA v2" -> "I'm not a robot" Checkbox
# 3. Masukkan domain (contoh: localhost untuk dev)
# 4. Salin Site Key dan Secret Key ke bawah ini:
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
