# ── Core (Production) ───────────────────────────────────
NODE_ENV=production
NODE_OPTIONS=--dns-result-order=ipv4first

# ── Database / Redis ─────────────────────────────────────
# Neon Production Connection Pooler (wajib sslmode=require)
DATABASE_URL=postgresql://neondb_owner:password@ep-prod-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Redis wajib aktif di production VPS (rate limiting & multi-process coordination)
REDIS_URL=redis://localhost:6379

# ── Web (Production Domains) ────────────────────────────
NEXT_PUBLIC_APP_URL=https://morphic.web.id
NEXT_PUBLIC_API_URL=https://morphic-api.web.id
NEXT_PUBLIC_GATEWAY_URL=https://morphic-api.web.id

# ── Better Auth (Production) ─────────────────────────────
# Wajib 32+ karakter acak: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://morphic.web.id

# ── Google OAuth ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── API Gateway (VPS Behind Reverse Proxy) ───────────────
# Mengikat ke loopback port 3001 di VPS (Nginx proxy dari 443 ke 3001)
API_PORT=3001
# AES-256-GCM key for provider credentials (32 bytes hex)
PROVIDER_ENC_KEY=
# Shared secret between web and api for internal calls
INTERNAL_API_SECRET=
HARD_RESERVE_CAP=16384
RESERVATION_TTL_MINUTES=10
UPSTREAM_TIMEOUT_MS=120000

# ── Provider API Keys ────────────────────────────────────
DAHL_API_KEY=

# ── Payments (Production / Live) ─────────────────────────
MOCK_PAYMENT_WEBHOOK_SECRET=

# Duitku (Production)
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_ENV=production

# PayPal (Live REST App)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=live
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_ENVIRONMENT=live
PAYPAL_WEBHOOK_ID=

# ── Resend / Email (Wajib di Production) ─────────────────
RESEND_API_KEY=
EMAIL_FROM="Morphic <noreply@morphic-api.web.id>"

# ── reCAPTCHA v2 (Proteksi Brute-force & Bot) ────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
