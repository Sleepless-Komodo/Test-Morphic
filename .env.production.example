# ── Core (Production) ───────────────────────────────────
NODE_ENV=production
NODE_OPTIONS=--dns-result-order=ipv4first

# ── Database / Redis ─────────────────────────────────────
# Neon Production Connection Pooler (wajib sslmode=require)
DATABASE_URL=postgresql://neondb_owner:password@ep-prod-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Optional local PostgreSQL fallback (Termux 127.0.0.1:5432/morphic with sslmode=disable)
DATABASE_URL_FALLBACK=postgresql://morphic_app:URL_ENCODED_PASSWORD@127.0.0.1:5432/morphic?sslmode=disable
DB_FAILOVER_ENABLED=true
# Max connections per local Postgres pool (fallback, or DATABASE_URL when not Neon). Default 10.
# Each connection is a Postgres backend (~5-10 MB). 2 GB VPS: 5.
# DB_POOL_MAX=5
DB_SYNC_INTERVAL_MS=600000
# Salin pembayaran/redeem ke Postgres lokal segera setelah commit (false = hanya sync periodik)
DB_SYNC_ON_WRITE=true
DB_SYNC_ON_WRITE_DEBOUNCE_MS=1500
# Catch-up sync + self-check otomatis 3 detik setelah server start (false = matikan)
DB_SYNC_ON_BOOT=true
# Redis wajib aktif di production VPS (rate limiting & multi-process coordination)
REDIS_URL=redis://localhost:6379

# ── Web (Production Domains) ────────────────────────────
NEXT_PUBLIC_APP_URL=https://morphic.web.id
NEXT_PUBLIC_API_URL=https://morphic-api.web.id
NEXT_PUBLIC_GATEWAY_URL=https://morphic-api.web.id

# ── Better Auth (Production) ─────────────────────────────
# Wajib 32+ karakter acak: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://morphic.web.id

# ── Google OAuth ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── API Gateway (VPS Behind Reverse Proxy) ───────────────
# Mengikat ke loopback port 3001 di VPS (Nginx proxy dari 443 ke 3001)
API_PORT=3001
# AES-256-GCM key for provider credentials (32 bytes hex)
PROVIDER_ENC_KEY=
# Shared secret between web and api for internal calls
INTERNAL_API_SECRET=
HARD_RESERVE_CAP=16384
RESERVATION_TTL_MINUTES=10
UPSTREAM_TIMEOUT_MS=120000
# API key auth cache TTL in ms (default 30000). Suspend/revoke from the web dashboard
# reaches API-key requests within this window; 0 disables the cache.
# API_KEY_AUTH_CACHE_TTL_MS=30000
# Max request body for /v1/chat/completions and /v1/responses (default 10485760 = 10MB).
# 2 GB VPS: 4194304 (4MB). Set ANTHROPIC_MAX_BODY_BYTES (default 32MB) to the same value.
# GATEWAY_MAX_BODY_BYTES=4194304
# ANTHROPIC_MAX_BODY_BYTES=4194304
# Max in-flight gateway requests per API process (0 = off, default). Over it: 503 server_overloaded.
# 2 GB VPS: 25.
# GATEWAY_GLOBAL_CONCURRENCY=25
TRUST_CF_CONNECTING_IP=1

# ── Provider API Keys ────────────────────────────────────
DAHL_API_KEY=
CHUTES_API_KEY=
INCEPTRON_API_KEY=
# Route models through model_provider_pool rows (models without rows keep primary/fallback)
POOL_ENABLED=true

# ── Payments (Production / Live) ─────────────────────────
MOCK_PAYMENT_WEBHOOK_SECRET=


# Duitku (Production)
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_ENV=production
# QRIS channel codes are merchant-configurable.
DUITKU_PRIMARY_PAYMENT_METHOD=
DUITKU_BACKUP_PAYMENT_METHOD=

# PayPal (Live REST App)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=live
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_ENVIRONMENT=live
PAYPAL_WEBHOOK_ID=

# ── Resend / Email (Wajib di Production) ─────────────────
RESEND_API_KEY=
EMAIL_FROM="Morphic <noreply@morphic-api.web.id>"

# ── reCAPTCHA v2 (Proteksi Brute-force & Bot) ────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
