{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/standalone/**", "dist/**"],
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "API_PORT",
        "PROVIDER_ENC_KEY",
        "INTERNAL_API_SECRET",
        "HARD_RESERVE_CAP",
        "RESERVATION_TTL_MINUTES",
        "DAHL_API_KEY",
        "MOCK_PAYMENT_WEBHOOK_SECRET",
        "DUITKU_MERCHANT_CODE",
        "DUITKU_API_KEY",
        "DUITKU_ENV",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_GATEWAY_URL",
        "NETLIFY",
        "REDIS_URL",
        "UPSTREAM_TIMEOUT_MS",
        "PAYPAL_CLIENT_ID",
        "PAYPAL_CLIENT_SECRET",
        "PAYPAL_ENVIRONMENT",
        "NEXT_PUBLIC_PAYPAL_CLIENT_ID",
        "NEXT_PUBLIC_PAYPAL_ENVIRONMENT",
        "NEXT_PUBLIC_RECAPTCHA_SITE_KEY",
        "RECAPTCHA_SECRET_KEY",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "TELEGRAM_BOT_TOKEN",
        "TELEGRAM_WEBHOOK_SECRET",
        "CLAUDE_RENTAL_TELEGRAM_USERNAME"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
